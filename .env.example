# Tên của Docker Image
IMAGE_NAME=vieneu-tts

# Tag của Docker Image
IMAGE_TAG=latest

# Port ứng dụng (Host)
PORT=7860

# Config cho HuggingFace
# HF_TOKEN=hf_... 

# Config cho System
# UID/GID để mapping quyền file (nếu cần trên Linux)
# USER_ID=1000
# GROUP_ID=1000



HF_HOME=/root/.cache/huggingface
PYTHONUNBUFFERED=1
PHONEMIZER_ESPEAK_LIBRARY=/usr/lib/x86_64-linux-gnu/libespeak-ng.so.1

GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=0

# Bảo mật
# Đăng nhập cho Web UI khi người khác truy cập được (Docker, LAN, link share)
# VIENEU_WEB_AUTH=admin:doi-mat-khau-nay
# Khoá cho API streaming (apps/openai_speech.py): Authorization: Bearer <key>
# VIENEU_API_KEY=

# apps/openai_speech.py là service nội bộ: không có trang quản trị, không CSDL.
# Nếu HOST không phải loopback (127.0.0.1/localhost/::1), VIENEU_API_KEY là bắt
# buộc — thiếu thì server dừng ngay khi khởi động (xem VIENEU_API_KEY ở trên).
# Sau reverse proxy: IP của proxy được tin X-Forwarded-For
# FORWARDED_ALLOW_IPS=127.0.0.1
# Chỉ bật nếu tin tưởng repo nhập ở "Custom Model": cho phép repo đó chạy code Python riêng
# VIENEU_TRUST_REMOTE_CODE=1

# Portal stack (docker/docker-compose.portal.yml): khoá service-to-service giữa
# portal API/worker và engine (apps/openai_speech.py, không có trang quản trị
# trong stack này). Compose bắt buộc đặt biến này, không có giá trị mặc định —
# thiếu là `docker compose up` dừng ngay, không khởi động engine không khoá.
# VIENEU_ENGINE_SERVICE_KEY=doi-khoa-nay

# --- Portal (user portal, src/vieneu_portal/): make portal-up ---
# Khoá ký session/CSRF; tối thiểu 32 byte, không có giá trị mặc định cho production.
# VIENEU_PORTAL_SECRET_KEY=doi-khoa-nay-it-nhat-32-byte
# Chuỗi kết nối Postgres (compose tự điền khi dùng make portal-up/portal-db-up)
# VIENEU_PORTAL_DATABASE_URL=postgresql://vieneu:vieneu@localhost:5432/vieneu_portal
# S3/MinIO lưu audio đã render và mẫu giọng; S3_PUBLIC_ENDPOINT dùng khi ký URL
# cho trình duyệt (khác với S3_ENDPOINT nếu MinIO chạy trong mạng nội bộ Docker).
# VIENEU_PORTAL_S3_ENDPOINT=http://localhost:9000
# VIENEU_PORTAL_S3_PUBLIC_ENDPOINT=http://localhost:9000
# VIENEU_PORTAL_S3_BUCKET=vieneu-portal
# VIENEU_PORTAL_S3_ACCESS_KEY=vieneu
# VIENEU_PORTAL_S3_SECRET_KEY=vieneu_minio_password
# URL + khoá dịch vụ của engine (phải khớp VIENEU_ENGINE_SERVICE_KEY ở trên khi
# chạy engine trong compose; engine KHÔNG publish port, chỉ gọi được từ trong stack).
# VIENEU_PORTAL_ENGINE_URL=http://engine:8000
# VIENEU_PORTAL_ENGINE_SERVICE_KEY=doi-khoa-nay
# Hạn mức tài khoản mới (token, ký tự/ngày, số ngày thử nghiệm)
# VIENEU_PORTAL_TRIAL_TOKENS=150000
# VIENEU_PORTAL_TRIAL_DAILY_CHARS=50000
# VIENEU_PORTAL_TRIAL_DAYS=14
# Tắt đăng ký mới khi cần (ví dụ trong lúc chạy migrate-sqlite --apply)
# VIENEU_PORTAL_SIGNUP_ENABLED=true