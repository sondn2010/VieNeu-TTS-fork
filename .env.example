# Tên của Docker Image
IMAGE_NAME=vieneu-tts

# Tag của Docker Image
IMAGE_TAG=latest

# Port ứng dụng (Host)
PORT=7860

# Config cho HuggingFace
# HF_TOKEN=hf_... 

# Config cho System
# UID/GID để mapping quyền file (nếu cần trên Linux)
# USER_ID=1000
# GROUP_ID=1000



HF_HOME=/root/.cache/huggingface
PYTHONUNBUFFERED=1
PHONEMIZER_ESPEAK_LIBRARY=/usr/lib/x86_64-linux-gnu/libespeak-ng.so.1

GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=0

# Bảo mật
# Đăng nhập cho Web UI khi người khác truy cập được (Docker, LAN, link share)
# VIENEU_WEB_AUTH=admin:doi-mat-khau-nay
# Khoá cho API streaming (apps/openai_speech.py): Authorization: Bearer <key>
# VIENEU_API_KEY=

# Trang quản trị của API streaming (http://<host>:8000/admin): người dùng, API key,
# từ điển phát âm, Script Lab, Help.
#   VIENEU_ADMIN=1 (mặc định): MỌI lệnh gọi /v1/* đều cần key (key tạo ở /admin/keys
#   hoặc VIENEU_API_KEY), kể cả khi chưa có key nào -> 401.
#   VIENEU_ADMIN=0: tắt trang quản trị, API chạy như cũ (mở nếu không đặt VIENEU_API_KEY).
# VIENEU_ADMIN=1
# CSDL SQLite (mặc định vieneu_data/admin.sqlite3; Docker: volume vieneu_data)
# VIENEU_ADMIN_DB=vieneu_data/admin.sqlite3
# Tài khoản admin đầu tiên. BẮT BUỘC khi CSDL chưa có admin (lần chạy đầu), nếu không
# server dừng ngay khi khởi động. Có thể thay bằng: python -m vieneu_admin create-admin <user>
# Bỏ qua khi đã có admin (đổi mật khẩu trong trang quản trị). Mật khẩu không bao giờ được ghi log.
# VIENEU_ADMIN_USER=admin
# VIENEU_ADMIN_PASSWORD=doi-mat-khau-nay
# Đặt 1 khi /admin được phục vụ qua HTTPS (cookie đăng nhập chỉ gửi qua HTTPS)
# VIENEU_COOKIE_SECURE=0
# Thư mục tài liệu cho trang Help (mặc định docs/ của repo; Docker: /workspace/docs)
# VIENEU_DOCS_DIR=docs
# Sau reverse proxy: IP của proxy được tin X-Forwarded-For (khoá đăng nhập theo IP client)
# FORWARDED_ALLOW_IPS=127.0.0.1
# Chỉ bật nếu tin tưởng repo nhập ở "Custom Model": cho phép repo đó chạy code Python riêng
# VIENEU_TRUST_REMOTE_CODE=1