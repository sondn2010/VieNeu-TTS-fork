{
  "version": 1,
  "kit": "engineer",
  "manifest": {
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/plan-format-kanban.cjs"
              ]
            }
          ]
        },
        {
          "matcher": "Agent|Task|TodoWrite|TodoRead",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/session-state.cjs"
              ]
            }
          ]
        },
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/usage-quota-cache-refresh.cjs"
              ]
            },
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/agent-behavior-linter.cjs"
              ]
            }
          ]
        }
      ],
      "PreCompact": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/precompact-capture.cjs"
              ]
            },
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/agent-behavior-linter.cjs"
              ]
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Write",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/descriptive-name.cjs"
              ]
            }
          ]
        },
        {
          "matcher": "Read|Write|Edit|Bash|PowerShell",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/privacy-block.cjs"
              ]
            }
          ]
        },
        {
          "matcher": "Bash|PowerShell|Read",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/scout-block.cjs"
              ]
            }
          ]
        },
        {
          "matcher": "Bash|PowerShell|WebFetch",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/secrets-inject.cjs"
              ]
            }
          ]
        },
        {
          "matcher": "Bash|PowerShell|Read|Grep|Glob",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/context-firewall.cjs"
              ]
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/session-heartbeat.cjs"
              ]
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/session-heartbeat.cjs"
              ]
            }
          ]
        },
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/session-init.cjs"
              ]
            }
          ]
        }
      ],
      "Stop": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/session-heartbeat.cjs"
              ]
            }
          ]
        },
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/cook-after-plan-reminder.cjs"
              ]
            },
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/session-state.cjs"
              ]
            },
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/usage-quota-cache-refresh.cjs"
              ]
            },
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/agent-behavior-linter.cjs"
              ]
            }
          ]
        }
      ],
      "SubagentStart": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-init.cjs"
              ]
            },
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/team-context-inject.cjs"
              ]
            }
          ]
        }
      ],
      "SubagentStop": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/session-state.cjs"
              ]
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/secret-output-guardrail.cjs"
              ]
            },
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/dev-rules-reminder.cjs"
              ]
            },
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/simplify-gate.cjs"
              ]
            },
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/session-heartbeat.cjs"
              ]
            }
          ]
        },
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "${CLAUDE_PLUGIN_ROOT}/hooks/usage-quota-cache-refresh.cjs"
              ]
            }
          ]
        }
      ]
    }
  }
}
