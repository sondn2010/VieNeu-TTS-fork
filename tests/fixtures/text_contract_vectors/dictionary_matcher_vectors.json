{
  "matcher_vectors": [
    {
      "description": "TC-12 longest match: km/h beats km",
      "text": "Tốc độ 5 km/h",
      "rules": [
        {
          "source": "km",
          "target": "ki lô mét",
          "whole_word": true,
          "case_sensitive": false,
          "enabled": true,
          "layer": "ACCOUNT",
          "list_order": 0
        },
        {
          "source": "km/h",
          "target": "ki lô mét trên giờ",
          "whole_word": true,
          "case_sensitive": false,
          "enabled": true,
          "layer": "ACCOUNT",
          "list_order": 0
        }
      ],
      "expected": "Tốc độ 5 ki lô mét trên giờ"
    },
    {
      "description": "TC-13 single pass, no rescan of generated target",
      "text": "A",
