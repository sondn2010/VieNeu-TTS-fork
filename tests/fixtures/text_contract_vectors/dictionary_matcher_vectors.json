    {
      "description": "capital I with dot above folds consistently (lower(), not casefold)",
      "text": "İ",
      "rules": [
        {
          "source": "İ",
          "target": "[DOTTED-I]",
          "whole_word": false,
          "case_sensitive": false,
          "enabled": true,
          "layer": "ACCOUNT",
          "list_order": 0
        }
      ],
      "expected": "[DOTTED-I]"
    },
    {
      "description": "plain ascii i does not fold-match capital I with dot above",
      "text": "i",
      "rules": [
        {
          "source": "İ",
          "target": "[DOTTED-I]",
          "whole_word": false,
          "case_sensitive": false,
          "enabled": true,
          "layer": "ACCOUNT",
          "list_order": 0
        }
      ],
      "expected": "i"
    },
    {
      "description": "sharp s does not fold-match 'ss' under lower()/toLowerCase() (unlike full casefold)",
